-- Таблица с описанием упражнений
CREATE TABLE ExerciseEntity (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    nameKey TEXT NOT NULL UNIQUE,
    type TEXT NOT NULL,
    pointsCoefficient REAL NOT NULL
);

-- Расширенная таблица подходов
CREATE TABLE WorkoutSetEntity (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    exerciseId INTEGER NOT NULL,
    timestamp INTEGER NOT NULL,
    reps INTEGER,
    weight REAL,
    durationSeconds INTEGER,
    distanceMeters INTEGER,
    effortPoints INTEGER NOT NULL,
    FOREIGN KEY(exerciseId) REFERENCES ExerciseEntity(id) ON DELETE CASCADE
);

-- Таблица целей, теперь в очках
CREATE TABLE DailyGoalEntity (
    date TEXT NOT NULL PRIMARY KEY,
    targetPoints INTEGER NOT NULL,
    completedPoints INTEGER NOT NULL DEFAULT 0
);

-- Таблица недельного плана, теперь в очках
CREATE TABLE WeeklyGoalEntity (
    dayOfWeek INTEGER NOT NULL PRIMARY KEY,
    targetPoints INTEGER NOT NULL
);

CREATE TABLE UnlockedAchievementEntity (
    id TEXT NOT NULL PRIMARY KEY,
    unlockedAt INTEGER NOT NULL
);

---
--- Запросы для Упражнений (Exercises)
---
getAllExercises:
SELECT * FROM ExerciseEntity ORDER BY nameKey;

upsertExercise {
    UPDATE ExerciseEntity
    SET type = :type,
        pointsCoefficient = :pointsCoefficient
    WHERE nameKey = :name;

    INSERT OR IGNORE INTO ExerciseEntity (nameKey, type, pointsCoefficient)
    VALUES (:name, :type, :pointsCoefficient);
}

---
--- Запросы для Подходов (Workout Sets)
---
getSetsByDate:
SELECT
    w.id, w.timestamp, w.reps, w.weight, w.durationSeconds, w.distanceMeters, w.effortPoints,
    e.id AS exerciseId, e.nameKey AS exerciseName, e.type AS exerciseType, e.pointsCoefficient
FROM WorkoutSetEntity AS w
JOIN ExerciseEntity AS e ON w.exerciseId = e.id
WHERE date(w.timestamp, 'unixepoch') = ?
ORDER BY w.timestamp ASC;

insertSet:
INSERT INTO WorkoutSetEntity(exerciseId, timestamp, reps, weight, durationSeconds, distanceMeters, effortPoints)
VALUES (?, ?, ?, ?, ?, ?, ?);

updateSetById:
UPDATE WorkoutSetEntity SET
    exerciseId = ?,
    reps = ?,
    weight = ?,
    durationSeconds = ?,
    distanceMeters = ?,
    effortPoints = ?
WHERE id = ?;

getSetById:
SELECT
    wse.id, wse.timestamp, wse.reps, wse.weight, wse.durationSeconds, wse.distanceMeters, wse.effortPoints,
    ee.id AS exerciseId, ee.nameKey AS exerciseName, ee.type AS exerciseType, ee.pointsCoefficient
FROM WorkoutSetEntity AS wse
JOIN ExerciseEntity AS ee ON wse.exerciseId = ee.id
WHERE wse.id = ?;

deleteSetById:
DELETE FROM WorkoutSetEntity WHERE id = ?;

getTotalEffortPoints:
SELECT sum(effortPoints) FROM WorkoutSetEntity;

getWeeklySummary:
SELECT
    strftime('%Y-%W', timestamp, 'unixepoch', 'weekday 0', '-6 days') AS weekId,
    sum(effortPoints) AS totalPoints
FROM WorkoutSetEntity
GROUP BY weekId
ORDER BY weekId DESC
LIMIT 8;

getDailySummaryForLast30Days:
SELECT
    date(timestamp, 'unixepoch') AS dayId,
    sum(effortPoints) AS totalPoints
FROM WorkoutSetEntity
WHERE timestamp >= strftime('%s', 'now', '-30 days')
GROUP BY dayId
ORDER BY dayId DESC;

getActiveDaysCount:
SELECT count(DISTINCT date(timestamp, 'unixepoch')) FROM WorkoutSetEntity;


---
--- Запросы для Дневных Целей (Daily Goals)
---
getGoalByDate:
SELECT * FROM DailyGoalEntity WHERE date = ?;

getAllGoals:
SELECT * FROM DailyGoalEntity ORDER BY date DESC;

upsertGoal {
    UPDATE DailyGoalEntity
    SET targetPoints = :targetPoints,
        completedPoints = :completedPoints
    WHERE date = :date;

    INSERT OR IGNORE INTO DailyGoalEntity (date, targetPoints, completedPoints)
    VALUES (:date, :targetPoints, :completedPoints);
}

updateCompletedPoints:
UPDATE DailyGoalEntity SET completedPoints = ? WHERE date = ?;

getGoalsForMonth:
SELECT * FROM DailyGoalEntity WHERE strftime('%Y-%m', date) = ?;

---
--- Запросы для Недельных Целей (Weekly Goals)
---
getWeeklyGoals:
SELECT * FROM WeeklyGoalEntity;

upsertWeeklyGoal {
    UPDATE WeeklyGoalEntity
    SET targetPoints = :targetPoints
    WHERE dayOfWeek = :dayOfWeek;

    INSERT OR IGNORE INTO WeeklyGoalEntity (dayOfWeek, targetPoints)
    VALUES (:dayOfWeek, :targetPoints);
}

---
--- Запросы для Достижений (Achievements)
---
getUnlockedAchievementIds:
SELECT id FROM UnlockedAchievementEntity;

unlockAchievement:
INSERT OR IGNORE INTO UnlockedAchievementEntity(id, unlockedAt) VALUES (?, ?);

-- Для "Ранней пташки" / "Ночной совы"
getSetCountByHour:
SELECT count(*) FROM WorkoutSetEntity WHERE CAST(strftime('%H', `timestamp`, 'unixepoch', 'localtime') AS INTEGER) >= ? AND CAST(strftime('%H', `timestamp`, 'unixepoch', 'localtime') AS INTEGER) < ?;

-- Для "Воина выходного дня"
getWorkoutCountOnDate:
SELECT count(*) FROM WorkoutSetEntity WHERE date(`timestamp`, 'unixepoch') = ?;

-- Для "Марафонца"
getTotalDistanceForExercise:
SELECT sum(distanceMeters) FROM WorkoutSetEntity JOIN ExerciseEntity ON WorkoutSetEntity.exerciseId = ExerciseEntity.id WHERE ExerciseEntity.nameKey = ?;

-- Для "Повелителя железа"
getTotalWeightLifted:
SELECT sum(reps * weight) FROM WorkoutSetEntity WHERE reps IS NOT NULL AND weight IS NOT NULL;

---
--- Запросы для Статистики (Statistics)
---

-- Получить сумму очков по дням для выбранной недели
getDailySummaryForWeek:
SELECT
    date(`timestamp`, 'unixepoch') AS day,
    sum(effortPoints) AS totalPoints
FROM WorkoutSetEntity
WHERE date(`timestamp`, 'unixepoch') BETWEEN :startDate AND :endDate
GROUP BY day
ORDER BY day;

-- Получить сумму очков по неделям для выбранного месяца
getWeeklySummaryForMonth:
SELECT
    strftime('%Y-%W', `timestamp`, 'unixepoch', 'weekday 0', '-6 days') AS weekId,
    sum(effortPoints) AS totalPoints
FROM WorkoutSetEntity
WHERE strftime('%Y-%m', `timestamp`, 'unixepoch') = :yearMonth
GROUP BY weekId
ORDER BY weekId;

-- Получить сумму очков по упражнениям для выбранного дня
getExerciseSummaryForDay:
SELECT
    ee.nameKey,
    sum(wse.effortPoints) AS totalPoints
FROM WorkoutSetEntity AS wse
JOIN ExerciseEntity AS ee ON wse.exerciseId = ee.id
WHERE date(wse.timestamp, 'unixepoch') = :date
GROUP BY ee.nameKey
ORDER BY totalPoints DESC;

getActiveDaysCountForPeriod:
SELECT count(DISTINCT date(`timestamp`, 'unixepoch'))
FROM WorkoutSetEntity
WHERE date(`timestamp`, 'unixepoch') BETWEEN :startDate AND :endDate;
